# =============================================================================
# STUDIO LANTERNE — VARIABLES D'ENVIRONNEMENT BACKEND
# =============================================================================

# Environnement
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase (Base de données & Authentification JWT)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# Fournisseurs LLM (via LiteLLM)
GROQ_API_KEY=gsk_votre_cle_groq
MISTRAL_API_KEY=votre_cle_mistral
GEMINI_API_KEY=votre_cle_google_gemini

# Paramètres Moteur IA & Budget (Low-Cost)
LLM_TIMEOUT_SECONDS=3.5
MAX_TOKENS_PER_GAME=50000
SLIDING_WINDOW_MESSAGES=8
DEBATE_ROUNDS_PER_DAY=2

